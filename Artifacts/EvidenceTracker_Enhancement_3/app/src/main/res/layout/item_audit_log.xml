<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@color/cardColor"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textAuditEntryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026-07-30 19:52:02"
        android:textColor="@color/lightGrey"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textAuditEntryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Evidence Updated"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textAuditEntryChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Location&#10;Lab → Court"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textAuditEntryUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Performed By: Administrator"
        android:textColor="@color/lightGrey"
        android:textSize="14sp"
        android:textStyle="italic" />

</LinearLayout>